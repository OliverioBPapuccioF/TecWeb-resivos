    {
      "name": "1. Recibos (CRUD y filtro)",
      "item": [
        {
          "name": "Listar recibos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('es una lista', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/resivo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resivo"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Métodos de pago",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('son los 4 métodos', () => pm.expect(pm.response.json()).to.eql(['Efectivo', 'Débito', 'Crédito', 'Transferencia']));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/resivo/metodos-pago",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resivo",
                "metodos-pago"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Crear recibo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', () => pm.response.to.have.status(201));",
                  "",
                  "const r = pm.response.json();",
                  "pm.test('devuelve el recibo con id, sin productos y total 0', () => {",
                  "  pm.expect(r.id).to.be.a('number');",
                  "  pm.expect(r.productos).to.eql([]);",
                  "  pm.expect(r.total).to.eql(0);",
                  "});",
                  "pm.test('recorta los espacios del nombre', () => pm.expect(r.nombre).to.eql('Kiosco Postman'));",
                  "// the next requests use this id",
                  "pm.collectionVariables.set('resivoId', r.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/resivo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resivo"
              ]
            },
            "description": "Crea el recibo de prueba y guarda su id en la variable resivoId. La carpeta 5 lo borra al final.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"  Kiosco Postman  \",\n  \"tiempoCompra\": \"2026-01-15\",\n  \"metodoPago\": \"Efectivo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Ver recibo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('es el recibo creado', () => {",
                  "  const r = pm.response.json();",
                  "  pm.expect(r.id).to.eql(Number(pm.collectionVariables.get('resivoId')));",
                  "  pm.expect(r.metodoPago).to.eql('Efectivo');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/resivo/{{resivoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resivo",
                "{{resivoId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Filtrar recibos por nombre",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "",
                  "const lista = pm.response.json();",
                  "pm.test('todos contienen \"postman\" (sin distinguir mayúsculas)', () =>",
                  "  lista.forEach((r) => pm.expect(r.nombre.toLowerCase()).to.include('postman')));",
                  "pm.test('incluye el recibo creado', () =>",
                  "  pm.expect(lista.map((r) => r.id)).to.include(Number(pm.collectionVariables.get('resivoId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/resivo?nombre=postman",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resivo"
              ],
              "query": [
                {
                  "key": "nombre",
                  "value": "postman"
                }
              ]
            },
            "description": "?nombre= filtra los recibos cuyo nombre contiene el texto, sin distinguir mayúsculas."
          },
          "response": []
        },
        {
          "name": "Modificar recibo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('cambió solo el método de pago', () => {",
                  "  const r = pm.response.json();",
                  "  pm.expect(r.metodoPago).to.eql('Débito');",
                  "  pm.expect(r.nombre).to.eql('Kiosco Postman');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/resivo/{{resivoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resivo",
                "{{resivoId}}"
              ]
            },
            "description": "En PATCH todos los campos son opcionales (tiene que venir al menos uno).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metodoPago\": \"Débito\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
