# EXAMPLE of the configuration of the Postgres container: copy it to database/.env
# (make levantar / make dev copy it if it does not exist). The .env is NOT committed.
#
# Postgres container: docker-compose passes these variables to it (env_file).
# The official image creates this user, password and database the first time it
# starts with an empty data folder (database/data).
# They have to match DB_USER, DB_PASSWORD and DB_NAME of backend-resivo/.env
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=resivo

# time zone of the container and of the database sessions
TZ=America/Argentina/Buenos_Aires
PGTZ=America/Argentina/Buenos_Aires
