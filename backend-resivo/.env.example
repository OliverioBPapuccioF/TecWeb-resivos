# EXAMPLE of the configuration of the backend: copy it to .env (cp .env.example .env, or
# make levantar / make dev, which copy it if .env does not exist). The .env is NOT committed
# (.gitignore); these values are the ones for local development.
#
# Backend configuration. Loaded by npm start / start:dev / start:debug / start:prod
# (when the backend runs inside Docker, docker-compose sets these values instead).
# If a variable is missing, the backend uses the default written in the code.

# port of the API
PORT=3000

# connection to Postgres (has to match database/.env)
# DB_HOST is localhost when the backend runs on your machine;
# inside Docker it is the name of the database service (db)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=resivo

# origin of the frontend allowed to call the API from the browser (CORS)
CORS_ORIGIN=http://localhost:4200

# time zone: "today" for the "no future dates" validation is the date in Argentina
TZ=America/Argentina/Buenos_Aires

# ---------- docker-compose (published ports on your machine) ----------
# These two are read by docker-compose.yml and the Makefile, not by the API.
# port of your machine where the database is published (localhost:DB_PORT_HOST).
# Change it if you already have another Postgres using 5432 (and DB_PORT above too)
DB_PORT_HOST=5432
# port of your machine where the API is published (localhost:API_PORT_HOST).
# If you change it, change also the apiUrl of the frontend (environment.docker.ts)
API_PORT_HOST=3000

# the containers of the other repo (back/front) share the docker-compose project name
# (resivos): without this, compose calls them "orphans" and suggests --remove-orphans
COMPOSE_IGNORE_ORPHANS=true
