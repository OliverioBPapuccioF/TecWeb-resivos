# Variables of docker-compose itself (read automatically from this folder).
# They are used inside docker-compose.yml, not inside the containers.

# port of your machine where the database is published (localhost:DB_PORT_HOST).
# Change it if you already have another Postgres using 5432,
# and use the same value in DB_PORT of backend-resivo/.env
DB_PORT_HOST=5432

# port of your machine where the API is published (localhost:API_PORT_HOST).
# If you change it, change also the apiUrl of the frontend (environments/)
API_PORT_HOST=3000

# port of your machine where the frontend is published (localhost:WEB_PORT_HOST).
# It is the same port as `ng serve`: stop one before starting the other.
# If you change it, change also CORS_ORIGIN in backend-resivo/.env
WEB_PORT_HOST=4200
