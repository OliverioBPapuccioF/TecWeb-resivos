# EXAMPLE: copy it to .env (cp .env.example .env, or make levantar, which copies it if .env
# does not exist). The .env is NOT committed (.gitignore).
#
# Variables of docker-compose (read automatically from this folder). They are NOT used by
# Angular: the address of the API is in src/environments/.

# port of your machine where the frontend is published (localhost:WEB_PORT_HOST).
# It is the same port as `ng serve`: stop one before starting the other.
# If you change it, change also CORS_ORIGIN in the .env of the backend
WEB_PORT_HOST=4200

# the containers of the other repo (back/front) share the docker-compose project name
# (resivos): without this, compose calls them "orphans" and suggests --remove-orphans
COMPOSE_IGNORE_ORPHANS=true
